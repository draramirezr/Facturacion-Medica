# SEGURIDAD
SECRET_KEY=cambia_esto_por_una_clave_secreta

# BASE DE DATOS
# Local:
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=tu_password
MYSQL_DATABASE=facturacion_medica
# En Railway NO copies localhost. Vincula el plugin MySQL para que
# existan MYSQLHOST / MYSQL_URL. Si MYSQL_HOST=localhost está en Variables, bórrala.

# EMAIL
SENDGRID_API_KEY=tu_api_key
EMAIL_FROM=admin@ejemplo.com

# CENTRO DE AYUDA
# URL pública del manual de usuario (http/https).
# Si se deja vacía, Centro de ayuda abre /ayuda hasta que el manual esté en línea.
MANUAL_URL=
SOPORTE_EMAIL=soporte@clinicrd.com
SOPORTE_TELEFONO=8098446360

# ENTORNO
FLASK_ENV=development
# Solo local. En Railway NO definas PORT: Railway lo inyecta (suele ser 8080).
PORT=5000
# Obligatoria en producción; debe ser HTTPS y apuntar al dominio público.
APP_BASE_URL=https://www.clinicrd.com

# Opciones locales inseguras: mantener en false salvo desarrollo aislado.
ALLOW_DEV_LOGIN_PREFILL=false
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
ALLOW_INSECURE_DEV_RESET_TOKEN=false
MAX_UPLOAD_BYTES=10485760
MAX_EXCEL_ROWS=5000

# FACTURACIÓN ELECTRÓNICA DGII (desactivada por defecto)
ECF_ENABLED=false
ECF_ENVIRONMENT=PRUEBAS
# Este segundo interruptor solo se permite con ambiente PRODUCCION.
# No habilitarlo antes de certificación, respaldo y cuenta piloto confirmada.
ECF_ALLOW_PRODUCTION=false

# Almacén recomendado para múltiples clientes. Dentro se utilizará:
# tenant-<ID>/certificate.p12 y tenant-<ID>/password.txt
ECF_TENANT_SECRETS_ROOT=C:/ARSFlow/secretos-ecf

# Compatibilidad temporal para pruebas con un único emisor.
# No utilizar estas opciones globales en producción multi-tenant.
ECF_CERTIFICATE_PATH=C:/ruta-segura/certificado.p12
# En producción prefiera un archivo montado por el gestor de secretos.
ECF_CERTIFICATE_PASSWORD_FILE=C:/ruta-segura/ecf-certificate-password.txt
# Solo para desarrollo local; no confirmar una clave real en Git.
ECF_CERTIFICATE_PASSWORD=

# URLs oficiales configurables por ambiente. Verificar contra la
# documentación DGII vigente antes de habilitar la integración.
# Segmentos: testecf=pruebas, certecf=certificación, ecf=producción.
ECF_AUTHENTICATION_URL=https://ecf.dgii.gov.do/testecf/autenticacion
ECF_RECEPTION_URL=https://ecf.dgii.gov.do/testecf/recepcion
ECF_RESULT_URL=https://ecf.dgii.gov.do/testecf/consultaresultado
ECF_TRACK_URL=https://ecf.dgii.gov.do/testecf/consultatrackids
ECF_STAMP_URL=https://ecf.dgii.gov.do/testecf/consultatimbre
ECF_CONNECT_TIMEOUT_SECONDS=10
ECF_READ_TIMEOUT_SECONDS=30
